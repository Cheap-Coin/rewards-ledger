{
  "name": "cheapcoin-rewards-ledger",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format:evidence": "node scripts/validate-ledger.mjs --format",
    "validate": "node scripts/validate-ledger.mjs",
    "check:append-only": "node scripts/check-append-only.mjs",
    "security:deps": "pnpm audit --audit-level high",
    "check": "pnpm validate && node --check scripts/check-append-only.mjs && node --check scripts/validate-ledger.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
