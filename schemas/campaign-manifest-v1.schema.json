{
  "$id": "https://cheapcoin.fun/schemas/campaign-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "asset": {
            "properties": {
              "kind": {
                "const": "NATIVE_SOL"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "asset": {
            "properties": {
              "decimals": {
                "const": 9
              },
              "mint": {
                "type": "null"
              },
              "tokenProgram": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "asset": {
            "properties": {
              "kind": {
                "const": "SPL_TOKEN"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "asset": {
            "properties": {
              "mint": {
                "$ref": "common-v1.schema.json#/$defs/address"
              },
              "tokenProgram": {
                "enum": [
                  "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
                ]
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "const": "SQUADS_BATCH"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "allocation": {
            "properties": {
              "recipientRoot": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "rewardsDeployment": {
            "type": "null"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "const": "MERKLE_REWARDS"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "allocation": {
            "properties": {
              "recipientRoot": {
                "$ref": "common-v1.schema.json#/$defs/sha256"
              }
            },
            "type": "object"
          },
          "asset": {
            "properties": {
              "kind": {
                "const": "SPL_TOKEN"
              }
            },
            "type": "object"
          },
          "rewardsDeployment": {
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ],
  "properties": {
    "allocation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?:fixtures/)?allocations/[a-z0-9._/-]+\\.json$",
          "type": "string"
        },
        "recipientCount": {
          "minimum": 1,
          "type": "integer"
        },
        "recipientRoot": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "recipientCount",
        "recipientRoot",
        "sha256"
      ],
      "type": "object"
    },
    "asset": {
      "additionalProperties": false,
      "properties": {
        "decimals": {
          "maximum": 9,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "NATIVE_SOL",
            "SPL_TOKEN"
          ]
        },
        "mint": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenProgram": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decimals",
        "kind",
        "mint",
        "tokenProgram"
      ],
      "type": "object"
    },
    "budget": {
      "$ref": "common-v1.schema.json#/$defs/positiveInteger"
    },
    "campaignId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "cluster": {
      "$ref": "common-v1.schema.json#/$defs/cluster"
    },
    "delivery": {
      "enum": [
        "SQUADS_BATCH",
        "MERKLE_REWARDS"
      ]
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "fixture": {
      "type": "boolean"
    },
    "launchManifestSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "recordType": {
      "const": "campaign"
    },
    "rewardsDeployment": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "auditedCommit": {
              "const": "aa1cfd9276375e44e57d1917d110ff095fb6d475"
            },
            "deploymentRecordPath": {
              "pattern": "^(?:fixtures/)?deployments/[a-z0-9._/-]+\\.json$",
              "type": "string"
            },
            "manifestSha256": {
              "$ref": "common-v1.schema.json#/$defs/sha256"
            },
            "programId": {
              "const": "REWArDioXgQJ2fZKkfu9LCLjQfRwYWVVfsvcsR5hoXi"
            }
          },
          "required": [
            "auditedCommit",
            "deploymentRecordPath",
            "manifestSha256",
            "programId"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(?:fixtures/)?rules/[a-zA-Z0-9._/-]+\\.md$",
          "type": "string"
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        },
        "uri": {
          "$ref": "common-v1.schema.json#/$defs/uri"
        }
      },
      "required": [
        "path",
        "sha256",
        "uri"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "snapshotSlot": {
      "$ref": "common-v1.schema.json#/$defs/positiveInteger"
    },
    "sourceTreasury": {
      "$ref": "common-v1.schema.json#/$defs/address"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "FUNDED",
        "ACTIVE",
        "EXPIRED",
        "RECONCILED"
      ]
    }
  },
  "required": [
    "allocation",
    "asset",
    "budget",
    "campaignId",
    "cluster",
    "delivery",
    "expiresAt",
    "fixture",
    "launchManifestSha256",
    "recordType",
    "rewardsDeployment",
    "rules",
    "schemaVersion",
    "snapshotSlot",
    "sourceTreasury",
    "status"
  ],
  "type": "object"
}
