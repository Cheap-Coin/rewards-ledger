{
  "$id": "https://cheapcoin.fun/schemas/reconciliation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allocationPath": {
      "pattern": "^(?:fixtures/)?allocations/[a-z0-9._/-]+\\.json$",
      "type": "string"
    },
    "allocationSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "budget": {
      "$ref": "common-v1.schema.json#/$defs/positiveInteger"
    },
    "campaignId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "campaignManifestPath": {
      "pattern": "^(?:fixtures/)?campaigns/[a-z0-9._/-]+\\.json$",
      "type": "string"
    },
    "campaignManifestSha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "cluster": {
      "$ref": "common-v1.schema.json#/$defs/cluster"
    },
    "distributed": {
      "$ref": "common-v1.schema.json#/$defs/nonnegativeInteger"
    },
    "fixture": {
      "type": "boolean"
    },
    "reconciledAt": {
      "format": "date-time",
      "type": "string"
    },
    "reconciliationId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "recordType": {
      "const": "reconciliation"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "COMPLETE",
        "EXPIRED_WITH_UNCLAIMED"
      ]
    },
    "transactions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "$ref": "common-v1.schema.json#/$defs/positiveInteger"
          },
          "finalizedSlot": {
            "$ref": "common-v1.schema.json#/$defs/positiveInteger"
          },
          "signature": {
            "$ref": "common-v1.schema.json#/$defs/signature"
          }
        },
        "required": [
          "amount",
          "finalizedSlot",
          "signature"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "unclaimed": {
      "$ref": "common-v1.schema.json#/$defs/nonnegativeInteger"
    }
  },
  "required": [
    "allocationPath",
    "allocationSha256",
    "budget",
    "campaignId",
    "campaignManifestPath",
    "campaignManifestSha256",
    "cluster",
    "distributed",
    "fixture",
    "reconciledAt",
    "reconciliationId",
    "recordType",
    "schemaVersion",
    "status",
    "transactions",
    "unclaimed"
  ],
  "type": "object"
}
